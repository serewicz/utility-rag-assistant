# Provider: fake (offline, default for tests), openai (any OpenAI-compatible API), ollama (on-prem)
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Empty = SQLite file. Set a postgres URL to use pgvector.
DATABASE_URL=
SQLITE_PATH=rag.db
# USD per 1M tokens, used for cost estimates
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# Live LCRA Hydromet lake levels (public, best-effort). 1 = on, 0 = off.
HYDROMET_LIVE=1
