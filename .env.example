# Provider. Recommended for a live demo: openai (paste your key below; never commit .env).
# On-prem: change this one line to LLM_PROVIDER=ollama. No key or no network: LLM_PROVIDER=fake.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Empty = SQLite file. Set a postgres URL to use pgvector.
DATABASE_URL=
SQLITE_PATH=rag.db
# USD per 1M tokens, used for cost estimates
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# Live LCRA Hydromet lake levels (public, best-effort). 1 = on, 0 = off.
HYDROMET_LIVE=1

# Answers whose best source scores below this count as low-confidence in the gap report.
LOW_CONFIDENCE_SCORE=0.15
# Users allowed to call /admin/* (reingest, refresh, run evals). Demo header auth.
ADMIN_USERS=dev,tim

# Nightly refresh of the public lcra.org pages in data/sources.yaml (respects robots.txt).
# 1 = on, 0 = off. REFRESH_HOUR is Central time (0-23). Admins can run it now: POST /admin/refresh
REFRESH_ENABLED=1
REFRESH_HOUR=2
